# Скопировать в .env и заполнить. Сам .env в git не попадает.
# Здесь только ИМЕНА переменных с пустыми значениями — значения никогда не коммитятся.


# Игровой сервер
Q3_BASEQ3=/path/to/baseq3     # каталог со своими pak0..pak8; в git не попадает
Q3_RCON_PASSWORD=

# Мост (src/proxy/bridge.ts)
ARENA_BRIDGE_PORT=27961        # QUIC/WebTransport наружу
ARENA_GAME_HOST=127.0.0.1      # куда переливать UDP
ARENA_GAME_PORT=27960
ARENA_BRIDGE_SECRET=           # произвольная случайная строка для QUIC
ARENA_CERT_DIR=var/dev-cert
# В боевом контуре — выпуск Let's Encrypt для домена моста:
# ARENA_CERT_FILE=/etc/letsencrypt/live/arena.sethub.org/fullchain.pem
# ARENA_KEY_FILE=/etc/letsencrypt/live/arena.sethub.org/privkey.pem
#
# Порт моста: 27961 понятнее в разработке, но в боевом контуре стоит
# рассмотреть 443/udp — из сетей, где режут нестандартные порты, к нему
# больше шансов достучаться. С сайтом он не столкнётся: тот слушает TCP.

# Приглашения
ARENA_TICKET_SECRET=           # ключ подписи билетов; пустой = вход свободный
ARENA_SITE_URL=                # куда ведёт ссылка, например http://127.0.0.1:8099/
ARENA_PUBLIC_BRIDGE=           # адрес моста для игроков, например arena.example:27961
ARENA_INVITE_HOURS=24

# Сайт
SITE_PORT=3100                 # где слушает сервер; 3000 часто уже занят
# SITE_URL — адрес, который видит БРАУЗЕР, а не порт сервера. Из него собирается
# адрес возврата для Discord и туда же человек попадает после входа.
#   разработка: http://127.0.0.1:5273  (приложение, оно переливает /api на сервер)
#   боевой:     https://arena.sethub.org
SITE_URL=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://arena:ПАРОЛЬ@127.0.0.1:5432/arena

# Вход через Discord: приложение заводится на discord.com/developers/applications,
# в Redirects добавить SITE_URL + /api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=                # длинная случайная строка, ею подписываются куки
ARENA_ADMIN_DISCORD_ID=        # твой id в Discord: этот аккаунт получит админку
                               # при первом входе. Иначе назначать роль было бы
                               # некому — панель без администратора бесполезна
